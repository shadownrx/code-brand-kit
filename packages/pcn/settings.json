{
  "workbench.colorTheme": "Hyper Term Black",
  "editor.accessibilitySupport": "on",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.hideOnboarding": true,
  "explorer.confirmDelete": false,
  "editor.minimap.enabled": false,
  "files.autoSave": "afterDelay",
  "workbench.activityBar.location": "top",
  "workbench.statusBar.visible": true,
  "workbench.browser.showInTitleBar": false,
  "window.commandCenter": true,
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/**": true,
    "**/.venv/**": true,
    "**/prebuilts/**": true,
    "**/buildroot/output/**": true
  },
  "search.exclude": {
    "**/node_modules": true
  },
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "workbench.layoutControl.enabled": true,
  "workbench.editor.enablePreview": false,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.list.smoothScrolling": true,
  "diffEditor.renderSideBySide": false,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.experimental.showMoves": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "scm.diffDecorations": "all",
  "scm.defaultViewMode": "tree",
  "git.autorefresh": true,
  "files.autoSaveDelay": 500,
  "editor.stickyScroll.enabled": true,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.guides.bracketPairs": "active",
  "editor.renderLineHighlight": "all",
  "editor.inlineSuggest.enabled": true,
  "editor.padding.top": 16,
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.tabs.enabled": true,
  "accessibility.signals.chatUserActionRequired": {
    "sound": "on"
  },
  "workbench.editor.empty.hint": "hidden",
  "chat.commandCenter.enabled": false,
  "files.exclude": {
    "**/.orca-worktree-trash": true,
    "*-wt-*": true
  },
  "workbench.colorCustomizations": {
    "[Hyper Term Black]": {
      "terminal.background": "#000000",
      "terminal.foreground": "#ffffff",
      "terminalCursor.foreground": "#ffffff",
      "terminalCursor.background": "#000000",
      "terminal.selectionBackground": "#333333",
      "terminal.selectionForeground": "#ffffff",
      "terminal.border": "#101010",
      "panel.background": "#000000",
      "panel.border": "#101010",
      "terminal.ansiBlack": "#000000",
      "terminal.ansiRed": "#ff5555",
      "terminal.ansiGreen": "#50fa7b",
      "terminal.ansiYellow": "#f1fa8c",
      "terminal.ansiBlue": "#bd93f9",
      "terminal.ansiMagenta": "#ff79c6",
      "terminal.ansiCyan": "#8be9fd",
      "terminal.ansiWhite": "#bbbbbb",
      "terminal.ansiBrightBlack": "#555555",
      "terminal.ansiBrightRed": "#ff5555",
      "terminal.ansiBrightGreen": "#50fa7b",
      "terminal.ansiBrightYellow": "#f1fa8c",
      "terminal.ansiBrightBlue": "#bd93f9",
      "terminal.ansiBrightMagenta": "#ff79c6",
      "terminal.ansiBrightCyan": "#8be9fd",
      "terminal.ansiBrightWhite": "#ffffff",
      "editor.background": "#000000",
      "sideBar.background": "#000000",
      "editorGroupHeader.tabsBackground": "#000000",
      "tab.activeBackground": "#000000",
      "tab.activeBorderTop": "#404040",
      "focusBorder": "#404040",
      "sideBarSectionHeader.background": "#000000",
      "activityBar.background": "#000000",
      "titleBar.activeBackground": "#000000",
      "titleBar.inactiveBackground": "#000000",
      "statusBar.background": "#000000",
      "statusBar.noFolderBackground": "#000000",
      "statusBar.debuggingBackground": "#000000",
      "editorGroupHeader.noTabsBackground": "#000000",
      "tab.inactiveBackground": "#000000",
      "tab.unfocusedActiveBackground": "#000000",
      "input.background": "#000000",
      "dropdown.background": "#000000",
      "quickInput.background": "#000000",
      "editorWidget.background": "#000000",
      "editorHoverWidget.background": "#000000",
      "notifications.background": "#000000",
      "menu.background": "#000000",
      "breadcrumb.background": "#000000",
      "editorStickyScroll.background": "#000000",
      "chat.requestBackground": "#000000",
      "chat.requestBubbleBackground": "#000000",
      "chat.editor.background": "#000000",
      "foreground": "#ffffff",
      "editor.foreground": "#ffffff",
      "sideBar.foreground": "#ffffff",
      "sideBarTitle.foreground": "#ffffff",
      "sideBarSectionHeader.foreground": "#ffffff",
      "activityBar.foreground": "#ffffff",
      "activityBar.inactiveForeground": "#ffffff",
      "titleBar.activeForeground": "#ffffff",
      "titleBar.inactiveForeground": "#ffffff",
      "statusBar.foreground": "#ffffff",
      "statusBar.noFolderForeground": "#ffffff",
      "tab.activeForeground": "#ffffff",
      "tab.inactiveForeground": "#ffffff",
      "tab.unfocusedActiveForeground": "#ffffff",
      "panelTitle.activeForeground": "#ffffff",
      "panelTitle.inactiveForeground": "#ffffff",
      "input.foreground": "#ffffff",
      "dropdown.foreground": "#ffffff",
      "quickInput.foreground": "#ffffff",
      "editorWidget.foreground": "#ffffff",
      "editorHoverWidget.foreground": "#ffffff",
      "notifications.foreground": "#ffffff",
      "menu.foreground": "#ffffff",
      "breadcrumb.foreground": "#ffffff",
      "icon.foreground": "#ffffff",
      "descriptionForeground": "#ffffff",
      "list.activeSelectionForeground": "#ffffff",
      "list.inactiveSelectionForeground": "#ffffff",
      "gitDecoration.modifiedResourceForeground": "#ffffff",
      "gitDecoration.untrackedResourceForeground": "#ffffff",
      "list.activeSelectionBackground": "#242424",
      "list.inactiveSelectionBackground": "#181818",
      "list.hoverBackground": "#181818",
      "editor.selectionBackground": "#333333",
      "editor.lineHighlightBackground": "#101010",
      "sideBar.border": "#101010",
      "editorGroup.border": "#101010",
      "editorGroupHeader.border": "#101010",
      "activityBar.border": "#101010",
      "titleBar.border": "#101010",
      "statusBar.border": "#101010",
      "sideBarSectionHeader.border": "#101010",
      "tab.border": "#101010",
      "widget.border": "#101010",
      "chat.requestBorder": "#101010",
      "chat.requestBubbleBorder": "#101010",
      "contrastBorder": "#00000000",
      "contrastActiveBorder": "#00000000"
    }
  },
  "terminal.integrated.fontFamily": "'JetBrains Mono'",
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.minimumContrastRatio": 4.5,
  "terminal.integrated.drawBoldTextInBrightColors": false,
  "terminal.integrated.confirmOnKill": "never",
  "terminal.integrated.confirmOnExit": "never",
  "editor.fontFamily": "'JetBrains Mono', Menlo, Consolas, monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.fontLigatures": true,
  "chat.editor.fontFamily": "'JetBrains Mono'",
  "workbench.tree.enableStickyScroll": true,
  "explorer.compactFolders": false,
  "editor.padding.bottom": 16,
  "terminal.integrated.shellIntegration.enabled": true,
  "editor.tokenColorCustomizations": {
    "[Hyper Term Black]": {
      "comments": "#ffffff",
      "strings": "#ffffff",
      "keywords": "#ffffff",
      "numbers": "#ffffff",
      "types": "#ffffff",
      "functions": "#ffffff",
      "variables": "#ffffff",
      "textMateRules": [
        {
          "scope": [
            "source",
            "text"
          ],
          "settings": {
            "foreground": "#ffffff"
          }
        }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Hyper Term Black]": {
      "enabled": true,
      "rules": {
        "*": "#ffffff"
      }
    }
  },
  "background.enabled": true,
  "background.fullscreen": {
    "images": [
      "__PCN_LOGO_URI__"
    ],
    "opacity": 0.25,
    "size": "220px auto",
    "position": "center center",
    "interval": 0,
    "random": false
  },
  "workbench.panel.defaultLocation": "bottom",
  "workbench.panel.opensMaximized": "never",
  "workbench.editor.tabSizing": "shrink",
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolPath": "last",
  "editor.renderWhitespace": "selection",
  "terminal.integrated.tabs.hideCondition": "singleTerminal",
  "terminal.integrated.tabs.title": "${process}",
  "terminal.integrated.tabs.description": "${cwdFolder}",
  "terminal.integrated.cursorWidth": 2,
  "material-icon-theme.folders.color": "#90a4ae",
  "material-icon-theme.folders.associations": {
    "macch-core": "server",
    "macch-hub": "app",
    "macch-hub-mobile": "mobile",
    "orca": "tools",
    "DepotBar": "ci",
    "observacion-cortes": "log"
  },
  "vscode-pets.petType": "cat",
  "vscode-pets.petColor": "white",
  "vscode-pets.petSize": "medium",
  "vscode-pets.position": "explorer",
  "vscode-pets.theme": "none"
}
